# Maintainer: you <you@example.invalid>
pkgname=splitvpn
pkgver=0.2.0
pkgrel=1
pkgdesc="Split-tunneling GUI client for OpenVPN (.ovpn) profiles"
arch=('any')
url="https://github.com/mixa12344321/splitvpn"
license=('MIT')
depends=('python' 'python-gobject' 'gtk3' 'openvpn' 'iproute2' 'iptables' 'util-linux' 'polkit')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=()
sha256sums=()

# This PKGBUILD lives in packaging/ but builds the project one directory
# up, so it works whether makepkg is invoked from the repository root or
# from inside packaging/ itself (there is nothing to fetch in source() --
# it always builds from this checkout, never a downloaded tarball).
_rootdir() {
  if [ -f "$startdir/pyproject.toml" ]; then
    echo "$startdir"
  else
    echo "$startdir/.."
  fi
}

build() {
  cd "$(_rootdir)"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

package() {
  cd "$(_rootdir)"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl

  install -Dm644 packaging/splitvpn.desktop \
    "$pkgdir/usr/share/applications/splitvpn.desktop"
  install -Dm644 packaging/org.splitvpn.helper.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.splitvpn.helper.policy"

  # Also installed system-wide (the wheel already bundles it too, which is
  # what splitvpn/i18n.py actually looks at first at runtime).
  install -Dm644 splitvpn/locale/ru/LC_MESSAGES/splitvpn.mo \
    "$pkgdir/usr/share/locale/ru/LC_MESSAGES/splitvpn.mo"
}
