# Maintainer: mixa12344321 <avya78145@gmail.com>
pkgname=splitvpn
pkgver=0.2.0
pkgrel=1
pkgdesc="Split-tunneling GUI client for OpenVPN (.ovpn) profiles, by IP/subnet or by application"
arch=('any')
url="https://github.com/mixa12344321/splitvpn"
license=('MIT')
depends=('python' 'python-gobject' 'gtk3' 'openvpn' 'iproute2' 'iptables' 'util-linux' 'polkit')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mixa12344321/splitvpn/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b2d99d8666f479317c759993953dff1a12d4661d468cfce887f767c2b1f80094')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/splitvpn.desktop \
    "$pkgdir/usr/share/applications/splitvpn.desktop"
  install -Dm644 packaging/org.splitvpn.helper.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.splitvpn.helper.policy"
  install -Dm644 splitvpn/locale/ru/LC_MESSAGES/splitvpn.mo \
    "$pkgdir/usr/share/locale/ru/LC_MESSAGES/splitvpn.mo"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
